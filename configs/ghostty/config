background = #060606
foreground = #e4e4e8
cursor-color = #e4e4e8
selection-background = #404040
selection-foreground = #e4e4e8


# ── Font ──────────────────────────────────────────────────────────────────────
font-family = Cartograph CF
font-feature = -liga
window-title-font-family = Cartograph CF

# ── Window ────────────────────────────────────────────────────────────────────
window-padding-x = 2
window-padding-y = 2
window-subtitle = working-directory
window-save-state = always

# ── Splits ───────────────────────────────────────────────────────────────────
unfocused-split-opacity = 0.85
split-inherit-working-directory = true

# ── macOS ────────────────────────────────────────────────────────────────────
macos-option-as-alt = left
macos-auto-secure-input = true
macos-icon = holographic
macos-icon-frame = plastic

# ── Shell integration ─────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,notify

# ── Keybindings ───────────────────────────────────────────────────────────────

# Quick terminal (global)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Shift+Enter → send ESC+CR (for shell widgets that use it)
keybind = shift+enter=text:\x1b\r

# Splits — vim-style navigation (Cmd+H/J/K/L)
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

# Splits — create
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Splits — resize (Cmd+Shift+H/J/K/L)
keybind = cmd+shift+h=resize_split:left,20
keybind = cmd+shift+j=resize_split:down,20
keybind = cmd+shift+k=resize_split:up,20
keybind = cmd+shift+l=resize_split:right,20

# Splits — zoom / equalize
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+ctrl+equal=equalize_splits

# Tabs — new / close
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

# Tabs — navigate (Cmd+1-9 are default: goto_tab:1-8 + last_tab)
# Kept as defaults — no override needed

# Neovim passthrough (direct, no tmux relay)
# Requires neovim kitty keyboard protocol: <D-p>, <D-S-f>, <D-S-p>
keybind = cmd+p=text:\x1b[112;9u
keybind = cmd+shift+f=text:\x1b[70;10u
keybind = cmd+shift+p=text:\x1b[80;10u

# Lazygit — floating window via AppleScript
keybind = cmd+g=text:ghostty-lazygit\r

# IDE layout — nvim + opencode + terminal via AppleScript
keybind = cmd+shift+i=text:ghostty-ide\r

# gtab
config-file = "/Users/conlin.durbin/.config/gtab/ghostty-shortcut.conf"
