#!/usr/bin/env bash
# ghostty-lazygit: open lazygit in a floating Ghostty window.
# Bind to Cmd+G in ghostty config: keybind = cmd+g=text:ghostty-lazygit\r
#
# The new window is floated on top via toggle_window_float_on_top so it
# sits above the main workspace like a popup.

CWD="$(pwd)"

osascript <<EOF
tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to "lazygit"
    set initial working directory of cfg to "$CWD"
    set win to new window with configuration cfg
end tell
EOF

# Float the new window on top after a brief moment for it to appear
sleep 0.2
osascript -e 'tell application "Ghostty" to activate'
# toggle_window_float_on_top via the action — send keystroke to trigger it
# We use the Ghostty CLI reload trick: ghostty sends the action to the front window
osascript <<'EOF'
tell application "System Events"
    tell process "Ghostty"
        -- Ghostty doesn't expose float via AppleScript directly;
        -- use the menu item if available, otherwise skip
        try
            click menu item "Float on Top" of menu "Window" of menu bar 1
        end try
    end tell
end tell
EOF
